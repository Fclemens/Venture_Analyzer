# ─── Clerk Authentication ────────────────────────────────────────────────────
# Get these from https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
CLERK_SECRET_KEY=sk_live_...

# Clerk redirect URLs (leave as-is unless you change the route structure)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Clerk webhook signing secret — Clerk dashboard → Webhooks → your endpoint → Signing Secret
# Subscribe to the "session.created" event
CLERK_WEBHOOK_SECRET=whsec_...

# ─── Encryption key for stored API keys ──────────────────────────────────────
# Generate with:  openssl rand -hex 32
# Must be exactly 64 hex characters (32 bytes = AES-256)
ENCRYPTION_KEY=your_64_char_hex_string_here

# ─── Pipeline (optional) ─────────────────────────────────────────────────────
# Where the SQLite database and embedding-model cache live. Point this at a
# persistent volume in production. Default: ./.data
# VENTURE_DATA_DIR=/var/lib/venture-analyzer

# Max method runs executing at once (whole server) and per user. Lower these if
# your LLM provider rate-limits you. Defaults: 3 and 2.
# PIPELINE_CONCURRENCY=3
# PIPELINE_PER_USER=2

# ─── Embeddings / outside data (optional) ────────────────────────────────────
# The first run downloads a 33 MB embedding model (~/.data/models). If it can't
# be loaded within this many ms, retrieval falls back to tag ranking and retries
# after the cooldown. Defaults: 90000 and 300000.
# EMBEDDING_LOAD_TIMEOUT_MS=90000
# EMBEDDING_RETRY_COOLDOWN_MS=300000

# Enable the SEC EDGAR connector (the SEC requires a contact address) and
# identify yourself politely to OpenAlex. Connectors are also opt-in per user in Settings.
# SEC_CONTACT_EMAIL=you@yourcompany.com
# CONNECTOR_CONTACT_EMAIL=you@yourcompany.com
