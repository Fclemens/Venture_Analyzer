# Dependencies & build output — rebuilt inside Docker
node_modules
.next

# Local data & model cache — should never be baked into the image
.data
.cache

# Environment files — injected at runtime, never baked in
.env
.env.local
.env.*.local

# Source control
.git
.gitignore

# Dev tooling
.eslintrc*
.prettierrc*
*.config.{js,mjs}
!next.config.ts
!tailwind.config.*
!postcss.config.*

# Docs & meta
*.md
LICENSE

# OS / editor artefacts
.DS_Store
Thumbs.db
.vscode
.idea
